<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/questionfilter/db" VERSION="20260805" COMMENT="Question bank filter block database"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="block_questionfilter_ratings" COMMENT="Star ratings for questions (1-5 stars, site-wide)">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="questionid"   TYPE="int"  LENGTH="10" NOTNULL="true"  COMMENT="ID of the rated question"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="false" COMMENT="NULL = guest rating"/>
        <FIELD NAME="sessionhash"  TYPE="char" LENGTH="64" NOTNULL="false" COMMENT="SHA256-like hash for guests"/>
        <FIELD NAME="rating"       TYPE="int"  LENGTH="1"  NOTNULL="true"  COMMENT="Rating 1-5"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"    TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_question" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
        <KEY NAME="fk_user"     TYPE="foreign" FIELDS="userid"     REFTABLE="user"     REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid_question"  UNIQUE="false" FIELDS="userid,questionid"/>
        <INDEX NAME="idx_session_question" UNIQUE="false" FIELDS="sessionhash,questionid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="block_questionfilter_tag_pending" COMMENT="AI-generated tag suggestions for questions (pending/applied/empty)">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="questionid"   TYPE="int"  LENGTH="10" NOTNULL="true"  COMMENT="Question ID (mdl_question.id)"/>
        <FIELD NAME="tags"         TYPE="text"             NOTNULL="false" COMMENT="Comma-separated tag suggestions"/>
        <FIELD NAME="status"       TYPE="char" LENGTH="10" NOTNULL="true"  COMMENT="pending|applied|empty|rejected"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_questionid" UNIQUE="true"  FIELDS="questionid"/>
        <INDEX NAME="idx_status"     UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
